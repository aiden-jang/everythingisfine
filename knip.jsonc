{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // One package, not a workspace. The app entry comes from index.html, which knip reads for itself.
  "entry": ["tools/*.mjs", "e2e/**/*.spec.ts", "src/**/*.test.{ts,tsx}"],
  "project": ["worker/**/*.ts", "analytics/**/*.ts", "src/**/*.{ts,tsx,css}", "tools/*.mjs", "e2e/**/*.ts"],
  // Vite aliases React imports to Preact; both dependency warnings describe that intentional alias.
  "ignoreDependencies": ["preact", "react", "react-dom"],
  // Include exports used only by their own file or tests; report symbols with no consumers.
  "ignoreExportsUsedInFile": true,
}
