{
  "name": "everythingisfine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 31600",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 31600",
    "gates": "node tools/check-gates.mjs",
    "size": "node tools/check-size.mjs",
    "docs": "node tools/check-docs.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run gates && pnpm run size && pnpm run docs && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:heap && pnpm run build && pnpm run test:e2e",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:heap": "NODE_OPTIONS=--expose-gc vitest run --pool=forks",
    "test:live": "EIF_LIVE=1 vitest run live.test",
    "test:e2e": "playwright test",
    "test:e2e:build": "EIF_BUILD=1 playwright test",
    "card": "node tools/make-card.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "earcut": "^3.2.3",
    "preact": "^10.29.8",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "prettier": "^3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
