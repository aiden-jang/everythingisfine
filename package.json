{
  "name": "everythingisfine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 31600",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 31600",
    "gates": "node tools/check-gates.mjs",
    "size": "node tools/check-size.mjs",
    "comments": "node tools/check-comments.mjs",
    "docs": "node tools/check-docs.mjs",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run gates && pnpm run security:check && pnpm run size && pnpm run comments && pnpm run css-vars && pnpm run docs && pnpm run knip && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:heap && pnpm run build && pnpm run dead-classes && pnpm run test:e2e",
    "deploy": "pnpm build && wrangler deploy",
    "test": "node --test tools/*.test.mjs && vitest run",
    "test:heap": "node --test tools/*.test.mjs && NODE_OPTIONS=--expose-gc vitest run --pool=forks",
    "test:live": "EIF_LIVE=1 vitest run live.test",
    "test:e2e": "playwright test",
    "test:e2e:build": "EIF_BUILD=1 playwright test",
    "card": "node tools/make-card.mjs",
    "css-vars": "node tools/check-css-vars.mjs",
    "dead-classes": "node tools/dead-classes.mjs",
    "security:check": "pnpm audit --audit-level=low"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "earcut": "^3.2.4",
    "preact": "^10.29.8",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.17.0"
  }
}
